# Copernicus Data Space Ecosystem — Sentinel Hub OAuth client (Sentinel-1 SAR)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Marine Service — ocean currents and waves
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Climate Data Store — ERA5 10 m wind
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# aisstream.io — live AIS over websocket (server side only; browsers are refused)
AISSTREAM_API_KEY=

# Global Fishing Watch API v3 — AIS-off events, vessel registry, infrastructure.
# Optional. Without it the ais_gap_overlap feature is computed from raw AIS only
# and the infrastructure mask falls back to a bundled fixture.
GFW_API_TOKEN=

# Postgres. Local dev uses the docker-compose service; production points at Supabase.
DATABASE_URL=postgresql+psycopg://avanta:avanta@db:5432/avanta

# Where cached rasters, netCDF subsets and generated dossiers live
DATA_DIR=/data

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://avanta.spacesdrive.cc

# Public base URL the frontend uses to reach this API
PUBLIC_API_BASE=http://localhost:8000
